<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-stt</artifactId>
        <version>2026.1105.123002</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The stt SERVICE layer: the one JAX-RS route (POST /stt/api/transcriptions) and the mapper
         that turns this context's framework-free DomainExceptions into HTTP responses. Everything
         that needs a web stack, and therefore cannot live in `domain`.

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the route" — because packaging it would have needed an
         auth variant and a main class. Both reasons have lapsed: this module validates the idp's
         bearer itself with quarkus-oidc (qits-1370), the same tenant every qits-auth-core service
         carries, and Quarkus supplies the main class. What remained was a route no process could
         serve.

         See migration-deployables-plan.md in the superproject. -->
    <artifactId>qits-stt-service</artifactId>
    <name>qits-stt :: service</name>
    <packaging>quarkus</packaging>

    <properties>
        <!-- THIS MODULE OPTS BACK INTO ITS INTEGRATION TESTS (the root pom's default is true).
             Every IT in the repository is a story class, they all share one @TestProfile so
             failsafe launches the fast-jar ONCE, and the whole catalogue is cheap: the only child
             processes are /bin/sh stand-ins the catalogue stages into target/. No docker, no
             database, no python, no model download and no network — so it does not compromise the
             clone-alone rule in AGENTS.md, and there is no heavyweight sibling IT for this flip to
             drag in.

             It also has to be on for the userflows pipeline to have anything to publish: those ITs
             are what emit target/userstories/, and .config/qits/ci-event-userflows.yml runs a plain
             `mvn verify` rather than naming classes — which is what keeps a new story class from
             being silently never run. -->
        <skipITs>false</skipITs>
    </properties>

    <dependencies>
        <dependency>
            <!-- /<segment>/q/health/ready - the readiness endpoint qits-cd's health gate curls;
                 the deployment convention every service answers. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-stt-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity and the role vocabulary the @RolesAllowed door below names. NOT an
                 auth variant and NOT an authorization policy — the monolith's -Dqits.variant
                 auth/* modules do not come here at all. Its forward-auth half (X-Qits-User /
                 X-Qits-Roles) leaves the library with qits-1338; quarkus-oidc below is what
                 authenticates a caller here. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-auth-core</artifactId>
        </dependency>
        <dependency>
            <!-- Checks the caller's qits-idp bearer (epic qits-543, qits-1370). A browser signs in
                 with an idp token and sends `Authorization: Bearer` through the edge (qits-1340),
                 and the edge no longer asserts X-Qits-User / X-Qits-Roles (qits-1373), so without
                 this tenant nobody could reach the route. Bearer only: no login flow, no session.
                 The token's `groups` claim becomes the roles, so the same @RolesAllowed boundary
                 decides. The settings are in application.properties.

                 It also brings quarkus-smallrye-jwt-build (through quarkus-oidc-common), which the
                 tests sign their tokens with. Do not declare that one again at test scope: a direct
                 test-scope entry would take it off the runtime classpath. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <!-- The named client `qits` (qits-428): this service's own qits:system bearer, minted by
                 client credentials from the deployer's idp:client resource
                 (quarkus.oidc-client.qits in application.properties). The tenant above checks the
                 tokens others present; this is the token this process presents. Its reader is
                 qits-telemetry-core below, which brings the extension anyway; declared here because
                 the client is this service's configuration, not the library's. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc-client</artifactId>
        </dependency>
        <dependency>
            <!-- CallerServerFilter: jandex-indexed, so merely being on this deployable's classpath
                 records inbound X-Qits-Caller as the qits.caller span attribute. This service
                 builds no HttpClient of its own, so nothing here calls QitsHttpClients.wrap. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-http-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- @Valid / @NotBlank on the request record. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- The API document at /stt/q/openapi and the browsable UI at /stt/q/swagger-ui. The
                 other five extracted services carried this out of the monorepo; stt did not, so it
                 was the one service that could not describe its own surface. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <!-- The instrumentation. The extension makes the spans, log records and metrics; the
                 exporters that ship them are qits-telemetry-core's, below. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP export to qits-observability through the edge (epic qits-428): replaces all
                 three of Quarkus' own OTLP exporters with CDI beans that attach the `qits` oidc
                 client's bearer on every export. The receiver is the module's default,
                 qits.telemetry.endpoint; quarkus.otel.exporter.otlp.* no longer reaches anything. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-telemetry-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- @TestSecurity: tests name the identity they mean instead of leaning on the forward-auth
                 dev user, which goes with qits-1338 (epic qits-543). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The user-story framework: this module's integration tests are written as @UserStory
                 methods, so the packaged-boot proof doubles as documentation — steps and a network
                 diagram emitted under target/userstories/. EVERY edge is observed: the framework's
                 own NetworkTaps.restAssured sees what arrives here, and stories/support/StoryEngine
                 reads what the service asked its two child processes for out of the recording those
                 stand-ins keep. Nothing in the catalogue is declared. The stories are browserless
                 (an Interactions parameter and no Flow), so the transitive Playwright never launches
                 anything and no browser is needed to run them. Version from the root pom. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-userflows</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The platform's shared ArchUnit rules: DeskAdminParityRules checks that every
                 route admitting qits:admin-agent also admits qits:desk-admin (epic qits-1621).
                 Test scope at every declaration site, like qits-userflows above. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-arch-rules</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar, and `<packaging>quarkus</packaging>`
                     above is what says so: it binds generate-code, generate-code-tests and build into
                     the lifecycle, so augmentation is not an execution someone can misplace. It was
                     one — declared under a `<build>` whose `<testResources>` came first, and the goal
                     silently never applied while `mvn verify` stayed green (migration-deployables-plan.md).
                     A packaging type cannot fail that way: without this `<extensions>true</extensions>`
                     the build stops at "Unknown packaging: quarkus". Version comes from the root pom's
                     pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- How @QuarkusIntegrationTest finds the compiled binary in a
                                     `-Dnative` build; without it the native run has nothing to
                                     launch. -->
                                <!-- The binary's name is `quarkus.package.output-name` in
                                     application.properties, not the maven finalName; the two have
                                     to be spelled the same or a native IT launches nothing. -->
                                <native.image.path>${project.build.directory}/qits-stt</native.image.path>
                                <!-- Launch the packaged app on a free port instead of the default
                                     8081, which qits-docs found occupied on the deployment host and
                                     which this repo's own AGENTS.md already records as the source of
                                     a @QuarkusTest port flake. The launcher reads the real port back
                                     out of the process's listening line, so nothing has to spell it
                                     twice. -->
                                <quarkus.http.test-port>0</quarkus.http.test-port>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build (the same profile qits' workspace-daemon and the platform's other
             native deployables carry):
             `-Dnative` disables the fast-jar and enables the native image. It lives in THIS module,
             not the root pom, because only this module is an application — `domain` is a library jar
             and has nothing to native-compile. skipITs flips with it so a native build runs the
             @QuarkusIntegrationTest suite against the binary rather than skipping it silently; it is
             redundant since this module's own properties opt in above, and is kept so the profile
             stays complete if that module default ever goes back to the root pom's `true`. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
